# Supabase - configuração do frontend
# Copie para .env.local e preencha com os dados do projeto
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini - configurar nos Secrets do Supabase
GEMINI_API_KEY=
import os
from google import genai

client = genai.Client(
    api_key=os.environ.get("GEMINI_API_KEY"),
)

tools = [
    {
        'type': 'google_search',
    },
]

generation_config = {
    'max_output_tokens': 65536,
    'thinking_level': 'high',
}

interaction = client.interactions.create(
    model='models/gemini-4-hydrogen',
    input="""INSERT_INPUT_HERE""",
    tools=tools,
    generation_config=generation_config,
)

print(interaction.steps[-1])




